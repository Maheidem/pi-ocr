{
  "name": "@maheidem/pi-ocr",
  "version": "0.1.1",
  "type": "module",
  "description": "Pi extension: OCR PDFs (page-split) and images via a configurable vision model, with raw-text + verdict returns and auditable JSON sidecars.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "ocr",
    "pdf",
    "vision-model",
    "tui"
  ],
  "license": "MIT",
  "author": "maheidem",
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node tests/run.mjs",
    "prepack": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@maheidem/pi-panel-kit": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.0.0",
    "typebox": "^1.0.17",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maheidem/pi-ocr.git"
  }
}
